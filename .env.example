# Copy to .env (never commit .env). EXPO_PUBLIC_* values are embedded in the app bundle,
# so they must not contain secrets.

# HTTPS page the app opens on launch.
EXPO_PUBLIC_WEB_URL=https://zat-ksa.com/

# Comma-separated hosts that may load in the main WebView frame (subdomains included).
# Defaults to the host of EXPO_PUBLIC_WEB_URL without "www.".
EXPO_PUBLIC_ALLOWED_HOSTS=zat-ksa.com
