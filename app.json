{
  "expo": {
    "name": "ذات",
    "slug": "zat-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f110f",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zat.app",
      "infoPlist": {
        "NSCameraUsageDescription": "يحتاج التطبيق إلى الكاميرا لالتقاط الصور ورفعها في الموقع.",
        "NSPhotoLibraryUsageDescription": "يحتاج التطبيق إلى مكتبة الصور لاختيار الصور ورفعها في الموقع.",
        "NSMicrophoneUsageDescription": "يحتاج التطبيق إلى الميكروفون لتسجيل مقاطع الفيديو ورفعها في الموقع.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zat.app",
      "adaptiveIcon": {
        "backgroundColor": "#0f110f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-dev-client"
    ],
    "scheme": "zatapp"
  }
}
